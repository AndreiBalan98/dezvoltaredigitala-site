  "modified": "2026-10-06T11:58:50",
  "excerpt": "<p>← Toate finanțările nerambursabile Estimează punctajul și finanțarea pentru programul AFM de baterii pentru prosumatori. Completează exact valorile din oferta instalatorului. 1Condiții de bază Am panouri fotovoltaice racordate la rețea și contract de prosumator. Am invertor hibrid sau îl montez pe banii mei, până la punerea în funcțiune a bateriei. Bateria e nouă, fără plumb, [&hellip;]</p>\n",
  "parent": 0,
  "categories": [],
  "featuredImage": null,
  "html": "\n<div class=\"ddcalc\" id=\"ddcalc\">\n  <style>\n    .ddcalc{--dd-acc:#1f6f43;--dd-acc2:#e8f4ec;--dd-txt:#1d2327;--dd-mut:#5f6b73;--dd-bor:#d5dbe0;--dd-soft:#f4f6f7;--dd-warn:#8a5a00;--dd-warnbg:#fff6e0;--dd-err:#a12622;--dd-errbg:#fdecec;\n      max-width:760px;margin:0 auto;font-family:inherit;color:var(--dd-txt);line-height:1.5;box-sizing:border-box}\n    .ddcalc *{box-sizing:border-box}\n    .ddcalc .dd-back{display:inline-block;margin:0 0 12px;color:var(--dd-acc);text-decoration:none;font-weight:600;font-size:.95em}\n    .ddcalc .dd-back:hover{text-decoration:underline}\n    .ddcalc .dd-intro{color:var(--dd-mut);margin:0 0 1.2em}\n    .ddcalc .dd-card{border:1px solid var(--dd-bor);border-radius:10px;padding:20px;background:#fff;margin-bottom:16px}\n    .ddcalc .dd-step{display:flex;align-items:center;gap:10px;margin:0 0 14px;font-size:1.05em;font-weight:700}\n    .ddcalc .dd-step span{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:var(--dd-acc2);color:var(--dd-acc);font-size:.85em}\n    /* Condiții de bază */\n    .ddcalc .dd-card.dd-bad{border-color:var(--dd-err);box-shadow:0 0 0 3px var(--dd-errbg)}\n    .ddcalc .dd-checks{list-style:none;margin:0;padding:0;display:grid;gap:10px}\n    .ddcalc .dd-checks label{display:flex;gap:10px;align-items:flex-start;cursor:pointer;font-weight:400}\n    .ddcalc .dd-checks input{width:18px;height:18px;margin:2px 0 0;flex:none;accent-color:var(--dd-acc)}\n    /* Câmpuri: etichetă, input, explicație, aliniate între coloane prin subgrid */\n    .ddcalc .dd-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:auto auto auto;column-gap:20px;row-gap:0}\n    .ddcalc .dd-field{display:grid;grid-row:span 3;grid-template-rows:subgrid;align-content:start}\n    .ddcalc .dd-field>label{align-self:end;font-weight:600;margin:0 0 6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .ddcalc .dd-in{position:relative}\n    .ddcalc .dd-in input{width:100%;height:46px;padding:0 52px 0 12px;font-size:1.05em;border:1px solid var(--dd-bor);border-radius:8px;background:#fff;color:var(--dd-txt)}\n    .ddcalc .dd-in input:focus{outline:none;border-color:var(--dd-acc);box-shadow:0 0 0 3px var(--dd-acc2)}\n    .ddcalc .dd-in input[aria-invalid=\"true\"]{border-color:var(--dd-err);box-shadow:0 0 0 3px var(--dd-errbg)}\n    .ddcalc .dd-in input.dd-warned{border-color:#d9a400}\n    .ddcalc .dd-unit{position:absolute;right:12px;top:50%;transform:translateY(-50%);color:var(--dd-mut);font-size:.9em;pointer-events:none}\n    .ddcalc .dd-hint{font-size:.85em;color:var(--dd-mut);margin-top:6px;line-height:1.35}\n    .ddcalc .dd-hint.err{color:var(--dd-err);font-weight:600}\n    .ddcalc .dd-hint.warn{color:var(--dd-warn);font-weight:600}\n    /* Rezultat */\n    .ddcalc .dd-total{display:flex;align-items:baseline;gap:8px;margin-bottom:8px}\n    .ddcalc .dd-total strong{font-size:2.4em;color:var(--dd-acc);line-height:1}\n    .ddcalc .dd-total.empty strong{color:#b3bbc1}\n    .ddcalc .dd-total.bad strong,.ddcalc .dd-total.bad span{color:var(--dd-err)}\n    .ddcalc .dd-bar{height:12px;border-radius:6px;background:#eef1f3;overflow:hidden;margin-bottom:8px}\n    .ddcalc .dd-bar span{display:block;height:100%;width:0;background:var(--dd-acc);transition:width .3s}\n    .ddcalc .dd-context{font-size:.85em;color:var(--dd-mut);margin:0 0 16px}\n    .ddcalc .dd-rows{display:grid;grid-template-columns:1fr auto;gap:6px 16px;margin:0}\n    .ddcalc .dd-rows dt{color:var(--dd-mut)}\n    .ddcalc .dd-rows dd{margin:0;font-weight:600;text-align:right}\n    .ddcalc .dd-sep{grid-column:1/-1;border-top:1px solid var(--dd-bor);margin:6px 0}\n    .ddcalc .dd-msg{border-radius:6px;padding:10px 12px;margin-top:12px;font-size:.95em}\n    .ddcalc .dd-msg.info{background:var(--dd-soft);color:var(--dd-mut)}\n    .ddcalc .dd-msg.warn{background:var(--dd-warnbg);color:var(--dd-warn)}\n    .ddcalc .dd-msg.err{background:var(--dd-errbg);color:var(--dd-err)}\n    .ddcalc .dd-msg.tip{background:var(--dd-acc2);color:var(--dd-acc)}\n    .ddcalc .dd-tips{list-style:none;margin:6px 0 0;padding:0;display:grid;gap:8px}\n    .ddcalc .dd-tips li{display:flex;gap:12px;align-items:center;justify-content:space-between}\n    .ddcalc .dd-apply{flex:none;border:1px solid var(--dd-acc);background:#fff;color:var(--dd-acc);border-radius:6px;padding:5px 12px;font:inherit;font-size:.9em;font-weight:600;cursor:pointer}\n    .ddcalc .dd-apply:hover{background:var(--dd-acc);color:#fff}\n    .ddcalc .dd-note{font-size:.85em;color:var(--dd-mut)}\n    .ddcalc .dd-cta{display:inline-block;margin-top:8px;padding:10px 18px;border-radius:6px;background:var(--dd-acc);color:#fff;text-decoration:none;font-weight:600}\n    .ddcalc .dd-cta:hover{opacity:.9;color:#fff}\n    /* Bara fixă cu scorul, doar pe telefon/tabletă */\n    .ddcalc .dd-sticky{display:none}\n    /* Tabletă: 2 coloane, contribuția pe tot rândul */\n    @media (max-width:720px){\n      .ddcalc .dd-grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(6,auto)}\n      .ddcalc .dd-field:last-child{grid-column:1/-1;margin-top:16px}\n      .ddcalc .dd-sticky.show{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:999;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;background:#fff;border-top:1px solid var(--dd-bor);box-shadow:0 -4px 16px rgba(0,0,0,.08)}\n      .ddcalc .dd-sticky strong{font-size:1.4em;color:var(--dd-acc)}\n      .ddcalc .dd-sticky button{border:0;background:var(--dd-acc);color:#fff;border-radius:6px;padding:8px 14px;font:inherit;font-weight:600;cursor:pointer}\n    }\n    /* Telefon: o coloană */\n    @media (max-width:480px){\n      .ddcalc .dd-grid{grid-template-columns:1fr;grid-template-rows:repeat(9,auto)}\n      .ddcalc .dd-field+.dd-field{margin-top:16px}\n      .ddcalc .dd-card{padding:16px}\n      .ddcalc .dd-total strong{font-size:2em}\n      .ddcalc .dd-tips li{flex-direction:column;align-items:flex-start;gap:6px}\n    }\n  </style>\n\n  <a class=\"dd-back\" id=\"dd-back\" href=\"/finantari-nerambursabile/\">← Toate finanțările nerambursabile</a>\n  <p class=\"dd-intro\">Estimează punctajul și finanțarea pentru programul AFM de baterii pentru prosumatori. Completează exact valorile din oferta instalatorului.</p>\n\n  <div class=\"dd-card\" id=\"dd-checkcard\">\n    <p class=\"dd-step\"><span>1</span>Condiții de bază</p>\n    <ul class=\"dd-checks\">\n      <li><label><input type=\"checkbox\" class=\"dd-chk\">Am panouri fotovoltaice racordate la rețea și contract de prosumator.</label></li>\n      <li><label><input type=\"checkbox\" class=\"dd-chk\">Am invertor hibrid sau îl montez pe banii mei, până la punerea în funcțiune a bateriei.</label></li>\n      <li><label><input type=\"checkbox\" class=\"dd-chk\">Bateria e nouă, fără plumb, cu BMS, garanție de minimum 5 ani și minimum 5.000 de cicluri.</label></li>\n      <li><label><input type=\"checkbox\" class=\"dd-chk\">Nu am datorii la bugetul de stat sau la cel local.</label></li>\n      <li><label><input type=\"checkbox\" class=\"dd-chk\">La adresă nu se desfășoară activități economice (sau consumul lor e contorizat separat).</label></li>\n      <li><label><input type=\"checkbox\" class=\"dd-chk\">Nu am beneficiat de finanțare din alte fonduri publice, naționale sau europene, pentru bateria de stocare.</label></li>\n    </ul>\n  </div>\n\n  <div class=\"dd-card\">\n    <p class=\"dd-step\"><span>2</span>Datele proiectului</p>\n    <div class=\"dd-grid\">\n      <div class=\"dd-field\">\n        <label for=\"dd-kwh\">Capacitatea bateriei</label>\n        <div class=\"dd-in\"><input id=\"dd-kwh\" type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"ex. 15\" aria-describedby=\"dd-kwh-h\"><span class=\"dd-unit\">kWh</span></div>\n        <span class=\"dd-hint\" id=\"dd-kwh-h\" data-def=\"Minimum 10 kWh pentru a fi eligibil.\">Minimum 10 kWh pentru a fi eligibil.</span>\n      </div>\n      <div class=\"dd-field\">\n        <label for=\"dd-vt\">Valoarea totală</label>\n        <div class=\"dd-in\"><input id=\"dd-vt\" type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"ex. 25.000\" aria-describedby=\"dd-vt-h\"><span class=\"dd-unit\">lei</span></div>\n        <span class=\"dd-hint\" id=\"dd-vt-h\" data-def=\"Cu TVA: baterie, montaj și invertor hibrid, dacă e cazul.\">Cu TVA: baterie, montaj și invertor hibrid, dacă e cazul.</span>\n      </div>\n      <div class=\"dd-field\">\n        <label for=\"dd-cp\">Contribuția proprie</label>\n        <div class=\"dd-in\"><input id=\"dd-cp\" type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"ex. 10.000\" aria-describedby=\"dd-cp-h\"><span class=\"dd-unit\">lei</span></div>\n        <span class=\"dd-hint\" id=\"dd-cp-h\" data-def=\"Cât plătești tu. Minimum 25% din total.\">Cât plătești tu. Minimum 25% din total.</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"dd-card\" id=\"dd-result\">\n    <p class=\"dd-step\"><span>3</span>Rezultat</p>\n    <div class=\"dd-total empty\" id=\"dd-total\"><strong id=\"dd-score\">–</strong><span id=\"dd-scorelbl\">/ 100 puncte</span></div>\n    <div class=\"dd-bar\"><span id=\"dd-bar\"></span></div>\n    <p class=\"dd-context\">Nu există un prag fix: cererile se finanțează în ordinea punctajului, până se termină bugetul. Cu cât punctajul e mai mare, cu atât șansele sunt mai bune.</p>\n    <dl class=\"dd-rows\">\n      <dt>Punctaj contribuție</dt><dd id=\"dd-p1\">– / 50</dd>\n      <dt>Punctaj baterie</dt><dd id=\"dd-p2\">– / 50</dd>\n      <div class=\"dd-sep\"></div>\n      <dt>Plătește AFM</dt><dd id=\"dd-afm\">–</dd>\n      <dt>Plătești tu</dt><dd id=\"dd-own\">–</dd>\n    </dl>\n    <div id=\"dd-msgs\" aria-live=\"polite\"></div>\n  </div>\n\n  <p class=\"dd-note\">Estimare orientativă, calculată după ghidul de finanțare AFM. Nu garantează obținerea finanțării. Punctajul se stabilește din ce declari la înscriere; dacă la final bateria sau contribuția proprie sunt mai mici decât ai declarat și punctajul ar scădea, AFM nu decontează finanțarea.</p>\n  <p><a class=\"dd-cta\" href=\"/contact/\">Vrei ajutor cu dosarul? Contactează-ne</a></p>\n\n  <div class=\"dd-sticky\" id=\"dd-sticky\" aria-hidden=\"true\">\n    <span><strong id=\"dd-sscore\">–</strong> / 100 puncte</span>\n    <button type=\"button\" id=\"dd-sbtn\">Vezi rezultatul</button>\n  </div>\n\n  <script>\n  (function () {\n    // ===== CONFIG: toate regulile programului. Pentru o schimbare de ghid, modifici doar aici. =====\n    var CONFIG = {\n      minKwh: 10,          // capacitate minimă eligibilă (kWh), art. 16\n      maxProcent: 0.75,    // finanțare AFM: max 75% din valoarea totală, art. 5\n      maxSuma: 15000,      // finanțare AFM: max 15.000 lei cu TVA, art. 5\n      costStd: 1500,       // standard de cost: lei / kWh, cu TVA, art. 5\n      maxContrib: 50,\n      maxBaterie: 50,\n      kwhMaxPuncte: 20,    // de la această capacitate se ia punctajul maxim la baterie\n      procentMaxContrib: 0.625, // 30 * cp / (total - cp) = 50  =>  cp = 62,5% din total\n      contribPoints: function (cp, afm) { return 30 * cp / afm; }, // art. 19 alin. 4 lit. a\n      bateriePoints: function (kwh) { return 2.5 * kwh; }          // art. 19 alin. 4 lit. b\n    };\n    // LOGIC START\n    function clamp(v, max) { return Math.max(0, Math.min(max, v)); }\n    function fmt(n) { return (Math.round(n * 10) / 10).toLocaleString('ro-RO'); }\n    function lei(n) { return Math.round(n).toLocaleString('ro-RO') + ' lei'; }\n    // Citește numere scrise românește: 25.000 / 25000 / 12,5 / 12.5\n    function parseNum(str, bani) {\n      var s = String(str).replace(/\\s/g, '');\n      if (s === '') return null;\n      if (!/^[0-9.,]+$/.test(s)) return NaN;\n      if (s.indexOf(',') !== -1) { s = s.replace(/\\./g, '').replace(',', '.'); }\n      else if (bani) { if (/^\\d{1,3}(\\.\\d{3})+$/.test(s)) s = s.replace(/\\./g, ''); }\n      if ((s.match(/[.,]/g) || []).length > 1) return NaN;\n      var v = parseFloat(s);\n      return isNaN(v) ? NaN : v;\n    }\n    // Verifică un câmp: '' = ok, 'req' = gol, altfel mesajul de eroare\n    function check(v) {\n      if (v === null) return 'req';\n      if (isNaN(v)) return 'Scrie doar cifre, de exemplu 25.000 sau 12,5.';\n      if (!(v > 0)) return 'Valoarea trebuie să fie mai mare decât 0.';\n      return '';\n    }\n    function calc(kwh, vt, cp) {\n      var r = { status: 'ok', err: { kwh: check(kwh), vt: check(vt), cp: check(cp) }, warn: {}, p1: 0, p2: 0, total: 0, afm: null, own: null, ownPct: null, minCp: null, tips: [] };\n      if (cp === 0) r.err.cp = '';\n      if (!r.err.kwh) { if (kwh < CONFIG.minKwh) { r.err.kwh = 'Minimum ' + CONFIG.minKwh + ' kWh. Proiectul nu este eligibil.'; r.status = 'neeligibil'; } }\n      if (!r.err.kwh) { if (!r.err.vt) {\n        r.minCp = vt - Math.min(CONFIG.maxProcent * vt, CONFIG.maxSuma, kwh * CONFIG.costStd);\n        if (!r.err.cp) {\n          if (cp >= vt) { r.err.cp = 'Trebuie să fie mai mică decât valoarea totală.'; r.status = 'neeligibil'; }\n          else if (cp < r.minCp - 0.5) { r.err.cp = 'Minimum ' + lei(r.minCp) + ' pentru acest proiect: AFM plătește cel mult 75% din total și cel mult ' + lei(CONFIG.maxSuma) + '.'; }\n        }\n      } }\n      if (r.status === 'ok') { if (r.err.kwh || r.err.vt || r.err.cp) r.status = 'incomplet'; }\n      if (r.status !== 'ok') return r;\n      r.afm = vt - cp; r.own = cp; r.ownPct = cp / vt * 100;\n      r.p1 = clamp(CONFIG.contribPoints(cp, r.afm), CONFIG.maxContrib);\n      r.p2 = clamp(CONFIG.bateriePoints(kwh), CONFIG.maxBaterie);\n      r.total = r.p1 + r.p2;\n      if (r.p1 < CONFIG.maxContrib - 0.05) {\n        var cpMax = Math.ceil(vt * CONFIG.procentMaxContrib);\n        r.tips.push({ text: 'Dacă plătești tu ' + lei(cpMax) + ' (AFM ' + lei(vt - cpMax) + '), iei punctajul maxim la contribuție: +' + fmt(CONFIG.maxContrib - r.p1) + ' puncte. Primești mai puțini bani, dar ai șanse mai mari.', apply: cpMax });\n      }\n      if (r.p2 < CONFIG.maxBaterie - 0.05) {\n        r.tips.push({ text: 'Cu o baterie de ' + CONFIG.kwhMaxPuncte + ' kWh iei punctajul maxim la baterie: +' + fmt(CONFIG.maxBaterie - r.p2) + ' puncte.' });\n      }\n      return r;\n    }\n    // LOGIC END\n    var root = document.getElementById('ddcalc');\n    if (!root) return;\n    function $(id) { return document.getElementById(id); }\n    var F = { kwh: 'dd-kwh', vt: 'dd-vt', cp: 'dd-cp' };\n    var NUME = { kwh: 'capacitatea bateriei', vt: 'valoarea totală', cp: 'contribuția proprie' };\n    var atins = {}, scris = false;\n    function val(k) { return parseNum($(F[k]).value, k !== 'kwh'); }\n    function render() {\n      var r = calc(val('kwh'), val('vt'), val('cp'));\n      Object.keys(F).forEach(function (k) {\n        var inp = $(F[k]), h = $(F[k] + '-h'), e = r.err[k], arata = false, txt = h.getAttribute('data-def'), cls = 'dd-hint';\n        if (e === 'req') { if (atins[k]) { arata = true; txt = 'Câmp obligatoriu.'; } }\n        else if (e) { arata = true; txt = e; }\n        if (arata) cls += ' err';\n        else if (r.warn[k]) { cls += ' warn'; txt = r.warn[k]; }\n        inp.setAttribute('aria-invalid', arata ? 'true' : 'false');\n        inp.classList.toggle('dd-warned', arata ? false : !!r.warn[k]);\n        h.className = cls; h.textContent = txt;\n      });\n      var bifate = root.querySelectorAll('.dd-chk:checked').length, nrChk = root.querySelectorAll('.dd-chk').length;\n      var conditii = bifate === nrChk;\n      var ok = r.status === 'ok' ? conditii : false;\n      $('dd-checkcard').classList.toggle('dd-bad', r.status === 'ok' ? !conditii : false);\n      $('dd-total').className = 'dd-total' + (ok ? '' : (r.status === 'neeligibil' ? ' bad' : ' empty'));\n      $('dd-score').textContent = ok ? fmt(r.total) : '–';\n      $('dd-scorelbl').textContent = r.status === 'neeligibil' ? 'Neeligibil' : '/ 100 puncte';\n      $('dd-bar').style.width = (ok ? clamp(r.total, 100) : 0) + '%';\n      $('dd-p1').textContent = (ok ? fmt(r.p1) : '–') + ' / ' + CONFIG.maxContrib;\n      $('dd-p2').textContent = (ok ? fmt(r.p2) : '–') + ' / ' + CONFIG.maxBaterie;\n      $('dd-afm').textContent = ok ? lei(r.afm) : '–';\n      $('dd-own').textContent = ok ? lei(r.own) + ' (' + fmt(r.ownPct) + '%)' : '–';\n      $('dd-sscore').textContent = ok ? fmt(r.total) : '–';\n      var m = [];\n      if (r.status === 'incomplet') {\n        var lipsa = Object.keys(F).filter(function (k) { return r.err[k] === 'req'; }).map(function (k) { return NUME[k]; });\n        var t = lipsa.length ? 'Completează ' + (lipsa.length > 1 ? lipsa.slice(0, -1).join(', ') + ' și ' + lipsa[lipsa.length - 1] : lipsa[0]) + ' pentru a vedea punctajul.' : 'Corectează valorile marcate cu roșu pentru a vedea punctajul.';\n        if (r.minCp !== null) { if (r.err.cp === 'req') t += ' Contribuția ta minimă pentru acest proiect: ' + lei(r.minCp) + '.'; }\n        m.push('<div class=\"dd-msg info\">' + t + '</div>');\n      }\n      if (r.status === 'neeligibil') m.push('<div class=\"dd-msg err\">Cu aceste valori proiectul nu poate fi finanțat. Vezi câmpul marcat cu roșu.</div>');\n      if (r.status === 'ok') { if (!conditii) m.push('<div class=\"dd-msg err\">Bifează toate cele ' + nrChk + ' condiții de bază (ai bifat ' + bifate + '). Dacă una nu e îndeplinită, cererea nu e eligibilă și punctajul nu se calculează.</div>'); }\n      if (ok) {\n        if (r.tips.length) {\n          m.push('<div class=\"dd-msg tip\"><strong>Cum poți crește punctajul</strong><ul class=\"dd-tips\">' + r.tips.map(function (tp) {\n            return '<li><span>' + tp.text + '</span>' + (tp.apply ? '<button type=\"button\" class=\"dd-apply\" data-apply=\"' + tp.apply + '\">Aplică</button>' : '') + '</li>';\n          }).join('') + '</ul></div>');\n        }\n      }\n      var html = m.join('');\n      if ($('dd-msgs').innerHTML !== html) $('dd-msgs').innerHTML = html;\n      sticky();\n    }\n    // formatare la ieșirea din câmp: 25000 devine 25.000, 12.5 devine 12,5\n    function formateaza(k) {\n      var v = val(k);\n      if (v === null || isNaN(v)) return;\n      $(F[k]).value = k === 'kwh' ? String(v).replace('.', ',') : Math.round(v).toLocaleString('ro-RO');\n    }\n    Object.keys(F).forEach(function (k) {\n      var inp = $(F[k]);\n      inp.addEventListener('input', function () { scris = true; render(); });\n      inp.addEventListener('blur', function () { atins[k] = true; formateaza(k); render(); });\n    });\n    root.querySelectorAll('.dd-chk').forEach(function (c) { c.addEventListener('change', render); });\n    $('dd-msgs').addEventListener('click', function (ev) {\n      var b = ev.target.closest('.dd-apply');\n      if (!b) return;\n      $('dd-cp').value = Number(b.getAttribute('data-apply')).toLocaleString('ro-RO');\n      render();\n    });\n    // bara fixă cu scorul: doar pe ecrane mici, când rezultatul nu se vede\n    var rezVizibil = true;\n    function sticky() { $('dd-sticky').classList.toggle('show', scris ? !rezVizibil : false); }\n    if ('IntersectionObserver' in window) {\n      new IntersectionObserver(function (en) { rezVizibil = en[0].isIntersecting; sticky(); }).observe($('dd-result'));\n    }\n    $('dd-sbtn').addEventListener('click', function () { $('dd-result').scrollIntoView({ behavior: 'smooth', block: 'start' }); });\n    // link înapoi: la pagina de unde a venit omul, dacă e de pe site\n    var ref = document.referrer;\n    if (ref) { if (ref.indexOf(location.origin) === 0) { if (ref !== location.href) { $('dd-back').href = ref; $('dd-back').textContent = '← Înapoi'; } } }\n    render();\n  })();\n  </script>\n</div>\n"
}
